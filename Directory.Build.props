<Project>
  <PropertyGroup>
    <BaseOutputPath>$(MSBuildThisFileDirectory)tmp\build\$(MSBuildProjectName)\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)tmp\build\$(MSBuildProjectName)\obj\</BaseIntermediateOutputPath>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>

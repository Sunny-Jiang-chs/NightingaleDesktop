<UserControl x:Class="Nightingale.Desktop.PlayerControls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
  <Border Background="#181D23" BorderBrush="#2C363E" BorderThickness="0,1,0,0" Padding="20,8,20,12">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="46"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="PositionLabel" Text="00:00" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" MinWidth="48"/>
        <Slider x:Name="SeekBar" Grid.Column="1" Style="{StaticResource SeekSlider}" Margin="10,0" Minimum="0" Maximum="1" ValueChanged="SeekValueChanged" PreviewMouseLeftButtonDown="SeekStarted" PreviewMouseMove="SeekMoved" PreviewMouseLeftButtonUp="SeekFinished" LostMouseCapture="SeekLostCapture" AutomationProperties.Name="播放进度"/>
        <TextBlock x:Name="DurationLabel" Grid.Column="2" Text="00:00" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" MinWidth="48" TextAlignment="Right"/>
      </Grid>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource IconButton}" Content="&#xE8FD;" ToolTip="播放列表 (L)" AutomationProperties.Name="播放列表" Click="QueueClicked" Margin="0,0,10,0"/>
          <Button Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="上一个 (Ctrl+←)" AutomationProperties.Name="上一个" Click="PreviousClicked"/>
          <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE768;" Width="44" Height="40" Background="#264D46" Foreground="{StaticResource Mint}" ToolTip="播放 / 暂停 (空格)" AutomationProperties.Name="播放或暂停" Click="PlayClicked" Margin="5,0"/>
          <Button Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="下一个 (Ctrl+→)" AutomationProperties.Name="下一个" Click="NextClicked"/>
          <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Content="&#xE767;" ToolTip="静音 (M)" AutomationProperties.Name="静音" Click="MuteClicked" Margin="16,0,0,0"/>
          <Slider x:Name="VolumeBar" Width="74" Minimum="0" Maximum="100" Value="75" IsMoveToPointEnabled="True" ValueChanged="VolumeChanged" ToolTip="音量" AutomationProperties.Name="音量"/>
        </StackPanel>
        <TextBlock x:Name="StatusLabel" Grid.Column="1" Foreground="{StaticResource Muted}" FontSize="12" Margin="18,0,8,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="SpeedButton" Content="1.0×" ToolTip="播放速度" AutomationProperties.Name="播放速度" Click="SpeedClicked" Padding="9,8"/>
          <Button Content="字幕" ToolTip="字幕与音轨" AutomationProperties.Name="字幕与音轨" Click="SubtitleClicked" Padding="9,8"/>
          <Button x:Name="TimerButton" Content="定时" ToolTip="睡眠定时" AutomationProperties.Name="睡眠定时" Click="TimerClicked" Padding="9,8"/>
          <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="设置" AutomationProperties.Name="设置" Click="SettingsClicked"/>
          <Button x:Name="FullscreenButton" Style="{StaticResource IconButton}" Content="&#xE740;" ToolTip="全屏 (F / 双击画面)" AutomationProperties.Name="全屏" Click="FullscreenClicked"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
